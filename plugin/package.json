{
  "name": "inspethct-vscode",
  "displayName": "Inspethct Debugger",
  "description": "VS Code debugger for Inspethct dbgserver",
  "version": "0.0.1",
  "icon": "icon.png",
  "publisher": "DenrianWeiss",
  "repository": "https://github.com/DenrianWeiss/inspethct",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onDebug",
    "onDebugResolve:inspethct",
    "onLanguage:solidity",
    "onCommand:inspethct.start",
    "onCommand:inspethct.debugFunction",
    "onCommand:inspethct.debugAtCursor",
    "onCommand:inspethct.debugContract",
    "onCommand:inspethct.importReplayFromChain",
    "onCommand:inspethct.runSequenceScript",
    "onCommand:inspethct.openSequenceBuilder",
    "onCommand:inspethct.openRepl"
  ],
  "contributes": {
    "breakpoints": [
      {
        "language": "solidity"
      }
    ],
    "debuggers": [
      {
        "type": "inspethct",
        "label": "Inspethct",
        "languages": [
          "solidity"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "request",
              "type",
              "name",
              "upstream"
            ],
            "properties": {
              "upstream": {
                "type": "string",
                "description": "Upstream RPC URL",
                "default": "http://127.0.0.1:8545"
              },
              "dbgserverUrl": {
                "type": "string",
                "description": "Use existing dbgserver endpoint in attach mode"
              },
              "listenHost": {
                "type": "string",
                "default": "127.0.0.1"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "listenPort": {
                "type": "number",
                "default": 18548
              },
              "block": {
                "type": "string",
                "default": "latest"
              },
              "fork": {
                "type": "string",
                "default": "cancun"
              },
              "forkMode": {
                "type": "string",
                "default": "diff"
              },
              "autoStartDbgserver": {
                "type": "boolean",
                "default": true
              },
              "dbgserverBinaryPath": {
                "type": "string",
                "description": "Path to inspethctd binary"
              },
              "sessionType": {
                "type": "string",
                "enum": [
                  "replay",
                  "call",
                  "sequence"
                ],
                "default": "replay"
              },
              "txHash": {
                "type": "string"
              },
              "call": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "input": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "gas": {
                    "type": "string"
                  },
                  "block": {
                    "type": "string"
                  }
                }
              },
              "sequence": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "Array of call steps for sequence mode"
              },
              "sourceBundle": {
                "type": "object",
                "description": "Optional source bundle config"
              },
              "promptSourceBundle": {
                "type": "boolean",
                "default": false,
                "description": "Deprecated. Source bundle is auto-detected when autoSourceBundle is true."
              },
              "autoSourceBundle": {
                "type": "boolean",
                "default": true,
                "description": "Auto-detect source bundle from local artifacts or block explorer."
              },
              "carryUserMutations": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Inspethct: Replay Transaction",
            "description": "Debug a chain transaction replay via dbgserver",
            "body": {
              "type": "inspethct",
              "request": "launch",
              "name": "Inspethct Replay",
              "sessionType": "replay",
              "upstream": "http://127.0.0.1:8545",
              "txHash": "0x",
              "autoStartDbgserver": true,
              "autoSourceBundle": true
            }
          },
          {
            "label": "Inspethct: Call Debug",
            "description": "Debug one synthetic call with custom sender",
            "body": {
              "type": "inspethct",
              "request": "launch",
              "name": "Inspethct Call",
              "sessionType": "call",
              "upstream": "http://127.0.0.1:8545",
              "call": {
                "from": "0x0000000000000000000000000000000000000001",
                "to": "0x",
                "input": "0x",
                "value": "0x0",
                "gas": "0x0",
                "block": "latest"
              },
              "autoStartDbgserver": true,
              "autoSourceBundle": true
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "inspethct.start",
        "title": "Inspethct: Start Debugging",
        "icon": "$(debug-start)"
      },
      {
        "command": "inspethct.debugFunction",
        "title": "Inspethct: Debug Function"
      },
      {
        "command": "inspethct.debugAtCursor",
        "title": "Inspethct: Debug at Cursor"
      },
      {
        "command": "inspethct.debugContract",
        "title": "Inspethct: Debug This Contract",
        "icon": "$(debug-alt)"
      },
      {
        "command": "inspethct.importReplayFromChain",
        "title": "Inspethct: Import Replay from Chain"
      },
      {
        "command": "inspethct.runSequenceScript",
        "title": "Inspethct: Run Sequence Script"
      },
      {
        "command": "inspethct.openSequenceBuilder",
        "title": "Inspethct: Open Sequence Builder"
      },
      {
        "command": "inspethct.openRepl",
        "title": "Inspethct: Open REPL"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "inspethct.debugAtCursor",
          "when": "resourceLangId == solidity",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "inspethct.debugContract",
          "when": "resourceLangId == solidity",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Inspethct",
      "properties": {
        "inspethct.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to inspethctd. If empty, extension searches PATH."
        },
        "inspethct.defaultUpstream": {
          "type": "string",
          "default": "http://127.0.0.1:8545"
        },
        "inspethct.defaultFork": {
          "type": "string",
          "default": "cancun"
        },
        "inspethct.defaultBlock": {
          "type": "string",
          "default": "latest"
        },
        "inspethct.defaultForkMode": {
          "type": "string",
          "default": "diff"
        },
        "inspethct.explorerApiBase": {
          "type": "string",
          "default": "https://api.etherscan.io/v2/api",
          "description": "Block explorer API base URL used as fallback for source detection."
        },
        "inspethct.explorerApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the explorer (required to fetch verified sources)."
        },
        "inspethct.explorerChainId": {
          "type": "string",
          "default": "1",
          "description": "Chain ID passed to the explorer (1 = Ethereum mainnet)."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.67.0",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.3"
  }
}
